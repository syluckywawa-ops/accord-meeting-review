{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionai.local/schemas/action_output_v1.schema.json",
  "title": "ActionAI structured action output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_items"],
  "properties": {
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "owners",
          "deadline_text",
          "deadline_normalized",
          "evidence_text",
          "evidence_ids",
          "needs_review",
          "review_reason"
        ],
        "properties": {
          "task": {"type": "string", "minLength": 1},
          "owners": {
            "type": "array",
            "items": {
              "enum": [
                "Project Manager",
                "Marketing Expert",
                "Industrial Designer",
                "User Interface Designer",
                "Team"
              ]
            }
          },
          "deadline_text": {"type": ["string", "null"]},
          "deadline_normalized": {
            "type": ["string", "null"]
          },
          "evidence_text": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[A-Z]{2}[0-9]{4}[a-d]-T[0-9]{4}$"}
          },
          "needs_review": {"type": "boolean"},
          "review_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
